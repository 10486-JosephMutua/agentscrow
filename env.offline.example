# AgentEscrow: OFFLINE DEMO preset. No PayPal account, no Groq key and no Docker are needed.
#
#   python -m scripts.quickstart          # copies this file to .env with fresh random secrets, then starts the server
#
# Everything the product does still runs (state machine, 3-tier arbiter, settlement policy, signed receipts, UI),
# but PayPal is an in-memory simulator and the worker is a deterministic script. Every simulated receipt says so.
# For the real PayPal sandbox + Groq agents see "Full run" in the README and use .env.example instead.

PAYPAL_MODE=simulated
WORKER_MODE=scripted
BUYER_MODE=direct
SEMANTIC_JUDGE=static

# Worker code runs in Docker when a Docker daemon is reachable (SANDBOX_BACKEND=auto). Otherwise it falls back to an
# UNISOLATED subprocess, which is acceptable ONLY for this local demo with built-in templates. Never expose it publicly.
SANDBOX_BACKEND=auto
ALLOW_UNSAFE_SANDBOX=true

# Filled in by scripts/quickstart.py (or put your own long random strings here).
MANDATE_SECRET=__MANDATE_SECRET__
ADMIN_TOKEN=__ADMIN_TOKEN__

DEMO_PERSONAS=true
API_HOST=127.0.0.1
API_PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
