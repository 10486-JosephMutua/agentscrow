# Copy to .env and fill in. NEVER commit .env.

# ---- PayPal (sandbox) ----------------------------------------------------------------
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Where worker payouts go. This sandbox address is PayPal's documented Payouts test receiver.
PAYPAL_WORKER_EMAIL=payouts-simulator-receiver@paypal.com
# sandbox   = the real PayPal sandbox API (use this for the demo video)
# simulated = in-memory stand-in, no PayPal needed (dev/CI only; everything is flagged "simulated")
PAYPAL_MODE=sandbox
# Webhook ID shown in the PayPal developer dashboard after you add a webhook for your app that points to
#   https://<your-public-host>/api/webhooks/paypal
# Subscribe it to: CHECKOUT.ORDER.APPROVED, PAYMENT.AUTHORIZATION.CREATED, PAYMENT.AUTHORIZATION.VOIDED,
#                  PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.PENDING
# Leave empty to run without webhooks (the return URL and polling still work).
PAYPAL_WEBHOOK_ID=

# ---- Groq ------------------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tried in order (after GROQ_MODEL) if the configured model is not available on your account
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# Optional: another Groq-compatible endpoint (a proxy, or a test server)
GROQ_BASE_URL=
# The semantic judge asks this many times and takes the MEDIAN of each score; any manipulation flag wins.
JUDGE_SAMPLES=3
# groq = LLM judge, static = fixed score (offline)
SEMANTIC_JUDGE=groq
# agent = Groq-powered buyer/worker agents, direct/scripted = deterministic (offline)
BUYER_MODE=agent
WORKER_MODE=agent

# ---- Security --------------------------------------------------------------------------
# Signs spending mandates, settlement tickets, access tokens and receipts. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MANDATE_SECRET=change-me-to-a-long-random-string
# Operator token for /ops and /api/admin/*. At least 16 characters. Leave empty to disable operator access.
ADMIN_TOKEN=
# How long a buyer/worker access token (kept in the browser) stays valid, in seconds (default 7 days)
CAPABILITY_TTL_S=604800
# Requests per minute per client for creating/accepting jobs
RATE_LIMIT_PER_MIN=30
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
PLATFORM_FEE_RATE=0.0667
# Operator sessions created by logging in on /ops last this long (seconds)
ADMIN_SESSION_TTL_S=28800
# Ed25519 key that signs verdict receipts (base64 of a 32-byte seed). Leave empty to create data/receipt_signing.key on first start.
# Keep that file safe: receipts stay verifiable with the published public key either way.
RECEIPT_SIGNING_KEY=
# Custom-task lint runs sandboxed code, so it is rate-limited separately (per minute per client)
VALIDATE_PER_MIN=6

# ---- Server limits ---------------------------------------------------------------------
# Concurrent live timelines (Server-Sent Events): in total and per client. Each one holds a server thread.
MAX_STREAMS=100
MAX_STREAMS_PER_IP=8
SERVER_THREADS=128
# Refuse to start a second server on the same database (the job runner and locks are in-process)
SINGLE_INSTANCE=true
# true lets buyers/workers pick the sloppy/cheating test personas (a demo and red-team feature). false = honest only.
DEMO_PERSONAS=true

# ---- Deadlines and holds ---------------------------------------------------------------
DEFAULT_DEADLINE_HOURS=24
# PayPal authorizations last 29 days; keep the maximum below that (1-28)
MAX_ESCROW_DAYS=25
SWEEP_INTERVAL_S=60

# ---- Sandbox for untrusted worker code -------------------------------------------------
# auto uses Docker when reachable and otherwise REFUSES to run worker code. Build the image once:
#   docker build -t agentescrow-sandbox -f docker/sandbox.Dockerfile .
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=agentescrow-sandbox
SANDBOX_TIMEOUT_S=20
# Extra seconds allowed for Docker to start/stop a container on top of SANDBOX_TIMEOUT_S. Raise it (e.g. 90) on a
# cold Docker Desktop / WSL2. If Docker never answers, the job goes to NEEDS_REVIEW (never VOID).
SANDBOX_START_GRACE_S=25
# Development only: allow the UNISOLATED subprocess fallback when Docker is not available
ALLOW_UNSAFE_SANDBOX=false

# ---- Servers ---------------------------------------------------------------------------
MCP_HOST=127.0.0.1
PAYPAL_MCP_PORT=8765
WORKBENCH_MCP_PORT=8766
# The marketplace MCP server that lets external agents earn on AgentEscrow (see examples/external_worker_agent.py)
MARKETPLACE_MCP_PORT=8767
# Where the marketplace MCP server finds the API (default: http://API_HOST:API_PORT)
# AGENTESCROW_API=http://127.0.0.1:5000
API_HOST=127.0.0.1
API_PORT=5000
# URL PayPal redirects the buyer back to (must be reachable from the buyer's browser)
PUBLIC_BASE_URL=http://localhost:5000
# Where the UI lives (also the allowed browser origin). When the server serves the built UI this is the same as PUBLIC_BASE_URL;
# with `npm run dev` set it to http://localhost:5173.
FRONTEND_URL=http://localhost:5000
# Folder with the built UI (frontend/dist); Flask serves it at /
# FRONTEND_DIST=

# ---- Logging / storage -----------------------------------------------------------------
LOG_LEVEL=INFO
