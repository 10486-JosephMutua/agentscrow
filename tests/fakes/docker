#!/usr/bin/env python3
"""A stand-in `docker` executable for tests.

`docker info` succeeds; `docker kill` is logged; `docker run ...` REFUSES (exit 125) unless the command line carries the
hardening flags AgentEscrow promises, and then runs the real sandbox entrypoint locally with the request on stdin, exactly
as the container would. FAKE_DOCKER_LOG records each invocation; FAKE_DOCKER_HANG=1 makes `run` hang (to test the kill path).
"""

import os
import subprocess
import sys
import time
from pathlib import Path

args = sys.argv[1:]
log = os.environ.get("FAKE_DOCKER_LOG")
if log:
    with open(log, "a") as handle:
        handle.write(" ".join(args) + "\n")

if not args or args[0] in {"info", "kill"}:
    sys.exit(0)

if args[0] != "run":
    print(f"fake docker: unsupported command {args[0]}", file=sys.stderr)
    sys.exit(1)

joined = " ".join(args)
required = ["--network none", "--read-only", "--cap-drop ALL", "--security-opt no-new-privileges", "--pids-limit", "--memory", " -i "]
missing = [flag for flag in required if flag not in f" {joined} "]
forbidden = [flag for flag in ("-v ", "--volume", "--privileged", "docker.sock", "--network host") if flag in f"{joined} "]
if missing or forbidden:
    print(f"fake docker: refusing an unsafe `docker run` (missing {missing}, forbidden {forbidden})", file=sys.stderr)
    sys.exit(125)

if os.environ.get("FAKE_DOCKER_HANG") == "1":
    time.sleep(600)

entrypoint = Path(__file__).resolve().parent.parent.parent / "docker" / "sandbox_entrypoint.py"
python = os.environ.get("FAKE_DOCKER_PYTHON", sys.executable)  # the interpreter that has pytest
sys.exit(subprocess.run([python, str(entrypoint)], stdin=sys.stdin, stdout=sys.stdout, stderr=sys.stderr).returncode)
